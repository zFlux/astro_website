---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import PrioritizationGrid from 'prioritization-grid/src/components/PrioritizationGrid';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import Footer from '../../components/Footer.astro';
import 'prioritization-grid/src/components/PrioritizationGrid.scss';
import 'prioritization-grid/src/components/ItemList.scss';
import 'prioritization-grid/src/components/ItemGrid.scss';
import 'prioritization-grid/src/components/ItemField.scss';
import 'prioritization-grid/src/components/ResultList.scss';
import 'prioritization-grid/src/components/ChoiceGrid.scss';
import 'prioritization-grid/src/components/ChoiceBox.scss';
import 'prioritization-grid/src/components/ResultGrid.scss';

const DEFAULT_MAX_ITEMS = 10;
const MIN_MAX_ITEMS = 1;
const MAX_MAX_ITEMS = 50;

export function getStaticPaths() {
  const min = 1, max = 50;
  return Array.from({ length: max - min + 1 }, (_, i) => ({
    params: { maxItems: String(i + min) },
  }));
}

const raw = Astro.params.maxItems ?? String(DEFAULT_MAX_ITEMS);
const parsed = parseInt(raw, 10);
const maxItems = Number.isNaN(parsed)
  ? DEFAULT_MAX_ITEMS
  : Math.min(MAX_MAX_ITEMS, Math.max(MIN_MAX_ITEMS, parsed));
---

<html>
<head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <style is:global>

        .title-header {
       
            background-color: rgba(209, 215, 221, 0.646);
        }
        .container {
            padding-top: 20px;
        }
   
        thead th { 
            position: sticky; 
            top: 0; z-index: 1; 
        }

        table  { 
            display: flex;
            flex-direction: column;
            align-items: center;
            border-collapse: collapse; 
            padding-bottom: 60px;
        }

        th,td { 
            padding: 8px 16px; 
            border: 1px solid #ddd;
        }

        .prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				color: rgb(var(--gray-dark));
                padding: .4em 0;
		}
        .title {

				padding: .2em 0;
				text-align: center;
        }

        p {
            margin: 1em 0;
        }

    </style>
</head>
<body>
    <Header />
     <div class="prose">
        <h1 class="title">Prioritization Grid</h1>
        
        <p>Have you ever had a list of options and no clear way to rank order them? If yes, this prioritization grid is here to help!</p>

        <ul>
            <li>First, list items to be prioritized in the 'Unprioritized' column on the left.</li>
            
            <li>Next, compare each item using the grid on the far right. Each box has two numbers in it. All you do is click which of the two numbers you like more. Do this for every available box in the grid on the far right of the page.</li>
            
            <li>The 'Prioritized' column will automatically update with the items in rank order.</li>
        </ul>
     </div>
    <div class="container">
        <PrioritizationGrid client:load maxItems={maxItems} />
    </div>
</body>
    <Footer />
</html>
